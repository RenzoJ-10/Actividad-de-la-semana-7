using System;

namespace CalculadoraMenu
{
    class Program
    {
        static void Main(string[] args)
        {
            int opcion;
            int num1, num2, resultado;

            do
            {
                // Menú
                Console.WriteLine("\n--- Calculadora ---");
                Console.WriteLine("1. Suma");
                Console.WriteLine("2. Resta");
                Console.WriteLine("3. Salir");
                Console.Write("Elige una opción (1-3): ");

                // Lectura y Conversión
                opcion = int.Parse(Console.ReadLine()); 

                switch (opcion)
                {
                    case 1:
                        Console.Write("Primer número: ");
                        num1 = int.Parse(Console.ReadLine());
                        Console.Write("Segundo número: ");
                        num2 = int.Parse(Console.ReadLine());
                        resultado = num1 + num2;
                        Console.WriteLine($"\nResultado: {resultado}");
                        break;

                    case 2:
                        Console.Write("Primer número: ");
                        num1 = int.Parse(Console.ReadLine());
                        Console.Write("Segundo número: ");
                        num2 = int.Parse(Console.ReadLine());
                        resultado = num1 - num2;
                        Console.WriteLine($"\nResultado: {resultado}");
                        break;

                    case 3:
                        Console.WriteLine("\nSaliendo de la aplicación. ¡Hasta pronto!");
                        break;

                    default:
                        Console.WriteLine("\nERROR: Opción no válida. Intenta de nuevo.");
                        break;
                }

                Console.ReadKey(); // Pausa para ver el resultado antes de limpiar y mostrar el menú de nuevo
                Console.Clear();
                
            } while (opcion != 3); // La condición de permanencia es MIENTRAS NO se elija la opción 3
        }
    }
}
