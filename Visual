using System;
using System.Collections.Generic;
using System.Diagnostics.CodeAnalysis;
using System.Linq;
using System.Text;
using System.Threading;
using System.Threading.Tasks;

namespace Semana_7
{
    internal class Program
    {
        static void Main(string[] args)
        {
            //VARIABLES
            int suma = 0;
            int cont = 0;
            int nota;

            double promedio;

            //DESARROLLO
            Console.Write("\nIngrese una nota: ");
            nota = int.Parse(Console.ReadLine());

            //BOUCLE WHILE CON IF Y ELSE
            while (nota != -1)
            {
                suma += nota;
                cont++;

                Console.Write("\nIngrese otra nota: ");
                nota = int.Parse(Console.ReadLine());

                Console.WriteLine("Resultados: ");

                if (cont > 0)
                {
                    promedio = (double)suma / cont;

                    Console.WriteLine($"1. La suma total de las notas es: {suma}");
                    Console.WriteLine($"2. El numero total de notas ingresadas es: {cont}");
                    Console.WriteLine($"3. El promedio de las notas es: {promedio:F2}");

                }
                else
                {
                    Console.WriteLine("NO SE INGRESARON LAS NOTAS");
                }
            }
        }
    }
}
